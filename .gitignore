# Composer (dev dependencies only -- the plugin has no runtime deps).
# composer.lock IS committed despite that: it pins exact dev-tool
# versions (PHPCS/PHPUnit/etc.) so CI stays reproducible across the PHP
# version matrix instead of silently drifting as those get updated.
/vendor/

# Test artifacts
.phpunit.result.cache
/tests/tmp/

# OS cruft
.DS_Store

# Editors
.idea/
.vscode/
