# Composer (dev dependencies only -- the plugin has no runtime deps).
# composer.lock is deliberately NOT committed: composer.json's version
# ranges (e.g. "phpunit/phpunit": "^9.6 || ^10.5") exist specifically so
# each PHP version in the CI matrix resolves its OWN compatible set
# (PHPUnit 9 on PHP 7.4/8.0, PHPUnit 10 on 8.3+) -- a single committed
# lock file freezes one resolution for everyone, which broke PHP 7.4/8.0
# in CI the first time this was tried (PHPUnit 10.5's own dependencies
# require PHP >=8.1, and a lock file skips re-resolving that per job).
/vendor/
composer.lock

# Integration tier's own isolated Composer context (pinned to PHPUnit
# 9.6 -- see tests/integration/composer.json for why) -- same reasoning
# as the root vendor/ above, not tied to the CI matrix since this tier
# is local-only.
/tests/integration/vendor/
/tests/integration/composer.lock

# Test artifacts
.phpunit.result.cache
/tests/tmp/

# Release zips built by bin/build-zip.sh
/dist/

# E2E tier (Playwright Test) -- saved login session, npm deps, HTML reports
/node_modules/
/tests/e2e/.auth/
/playwright-report/
/test-results/

# Playwright MCP browser-automation tool traces/screenshots (an AI
# assistant's ad-hoc verification tooling, not this project's own E2E
# tier -- that's /tests/e2e/, ignored separately above).
/.playwright-mcp/

# OS cruft
.DS_Store

# Editors
.idea/
.vscode/
